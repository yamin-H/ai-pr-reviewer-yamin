generator client {
    provider        = "prisma-client"
    output          = "../src/generated/prisma"
    previewFeatures = ["postgresqlExtensions"]
}

datasource db {
    provider   = "postgresql"
    extensions = [vector]
}

model Organization {
    id                String         @id @default(cuid())
    githubId          String         @unique
    login             String         @unique
    installationId    Int            @unique
    createdAt         DateTime       @default(now())
    isInstalled       Boolean        @default(true)
    uninstalledAt     DateTime?
    reviewSensitivity Float          @default(0.5) // confidence threshold (0.1 to 0.9)
    triggerOnSync     Boolean        @default(true) // review on PR synchronize (new commits)
    plan              String         @default("free") // "free" | "pro" | "enterprise"
    monthlyReviewCount Int           @default(0)
    lastQuotaResetAt  DateTime       @default(now())
    planExpiresAt     DateTime?
    users             User[]
    repos             Repo[]
    reviews           PRReview[]
    digests           WeeklyDigest[]
    memoryEntries     MemoryEntry[]
    usageEvents       UsageEvent[]
}

model User {
    id              String           @id @default(cuid())
    githubId        String           @unique
    login           String
    avatarUrl       String?
    createdAt       DateTime         @default(now())
    orgId           String
    org             Organization     @relation(fields: [orgId], references: [id])
    feedbackActions FeedbackAction[]
}

model Repo {
    id            String        @id @default(cuid())
    githubId      String        @unique
    name          String
    fullName      String
    private       Boolean       @default(false)
    enabled       Boolean       @default(true) // whether AI reviews are active for this repo
    customRulesCount Int        @default(0) // count of active custom rules from .powerful.yml
    orgId         String
    org           Organization  @relation(fields: [orgId], references: [id])
    reviews       PRReview[]
    memoryEntries MemoryEntry[]
    usageEvents   UsageEvent[]
    createdAt     DateTime      @default(now())
}

model PRReview {
    id              String           @id @default(cuid())
    prNumber        Int
    prTitle         String?
    status          String           @default("pending") // pending | completed | failed
    riskScore       Int?             // 0-100 computed risk score
    commentUrl      String?
    filesReviewed   Int              @default(0)
    commentsCount   Int              @default(0)
    createdAt       DateTime         @default(now())
    completedAt     DateTime?
    repoId          String
    repo            Repo             @relation(fields: [repoId], references: [id])
    orgId           String
    org             Organization     @relation(fields: [orgId], references: [id])
    comments        ReviewComment[]
    feedbackActions FeedbackAction[]
}

model ReviewComment {
    id              String           @id @default(cuid())
    filename        String
    line            Int
    severity        String
    comment         String
    confidence      Float
    pastPrNumber    Int?
    reviewId        String
    review          PRReview         @relation(fields: [reviewId], references: [id])
    createdAt       DateTime         @default(now())
    feedbackActions FeedbackAction[]
}

model MemoryEntry {
    id           String   @id @default(cuid())
    content      String
    embedding    Unsupported("vector(384)")?
    decisionType String
    outcome      String
    prNumber     Int
    filePath     String?
    createdAt    DateTime @default(now())
    repoId       String
    repo         Repo     @relation(fields: [repoId], references: [id])
    orgId        String
    org          Organization @relation(fields: [orgId], references: [id])
}

model FeedbackAction {
    id        String         @id @default(cuid())
    action    String
    createdAt DateTime       @default(now())
    userId    String
    user      User           @relation(fields: [userId], references: [id])
    reviewId  String
    review    PRReview       @relation(fields: [reviewId], references: [id])
    commentId String?
    comment   ReviewComment? @relation(fields: [commentId], references: [id])
}

model WeeklyDigest {
    id              String       @id @default(cuid())
    weekOf          DateTime
    prsReviewed     Int
    flagsRaised     Int
    flagsApproved   Int
    flagsDismissed  Int
    topIssue        String?
    topDismissed    String?
    patternsLearned Int          @default(0)
    sentAt          DateTime?
    createdAt       DateTime     @default(now())
    orgId           String
    org             Organization @relation(fields: [orgId], references: [id])
}

model UsageEvent {
    id               String        @id @default(cuid())
    eventType        String        @default("pr_review") // "pr_review" | "digest" | "historical_sync"
    model            String        @default("llama-3.3-70b-versatile")
    llmCalls         Int           @default(1)
    promptTokens     Int           @default(0)
    completionTokens Int           @default(0)
    totalTokens      Int           @default(0)
    durationMs       Int           @default(0)
    createdAt        DateTime      @default(now())
    orgId            String
    org              Organization  @relation(fields: [orgId], references: [id])
    repoId           String?
    repo             Repo?         @relation(fields: [repoId], references: [id])
    reviewId         String?
}

