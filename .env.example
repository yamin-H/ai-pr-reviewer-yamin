# GitHub App Credentials
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# AI Inference (Groq Cloud)
GROQ_API_KEY=

# Database (PostgreSQL 16+ with pgvector extension)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pr_reviewer?schema=public"

# Session Security (32+ character random string for iron-session)
SESSION_SECRET=

# Internal Service-to-Service Security Key (Shared between API and Agent)
INTERNAL_SERVICE_KEY=

# Webhook Security for Billing (Optional)
BILLING_WEBHOOK_SECRET=

# Service Endpoints & Networking
FRONTEND_URL=http://localhost:3001
AGENT_URL=http://localhost:8000
NODE_API_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379

# Client-Facing Variables
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL_BROWSER=http://localhost:3000
NEXT_PUBLIC_GITHUB_APP_NAME=powerful-pr-agent
